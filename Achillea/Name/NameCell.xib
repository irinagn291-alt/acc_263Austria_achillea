<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23504"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <tableViewCell clipsSubviews="YES" contentMode="scaleToFill" selectionStyle="none" indentationWidth="10" reuseIdentifier="NameCell" rowHeight="80" id="cell" customClass="NameCell" customModule="Achillea" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="390" height="80"/>
            <autoresizingMask key="autoresizingMask"/>
            <tableViewCellContentView key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" insetsLayoutMarginsFromSafeArea="NO" tableViewCell="cell" id="con">
                <rect key="frame" x="0.0" y="0.0" width="390" height="80"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="card">
                        <subviews>
                            <textField opaque="NO" contentMode="scaleToFill" horizontalHuggingPriority="249" contentHorizontalAlignment="left" contentVerticalAlignment="center" textAlignment="natural" minimumFontSize="12" translatesAutoresizingMaskIntoConstraints="NO" id="nf">
                                <constraints>
                                    <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="44" id="nfh"/>
                                </constraints>
                                <fontDescription key="fontDescription" style="UICTFontTextStyleBody"/>
                                <textInputTraits key="textInputTraits" autocapitalizationType="words" returnKeyType="done"/>
                            </textField>
                            <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="right" contentVerticalAlignment="center" textAlignment="right" minimumFontSize="12" translatesAutoresizingMaskIntoConstraints="NO" id="mf">
                                <constraints>
                                    <constraint firstAttribute="width" constant="72" id="mfw"/>
                                    <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="44" id="mfh"/>
                                </constraints>
                                <fontDescription key="fontDescription" style="UICTFontTextStyleBody"/>
                                <textInputTraits key="textInputTraits" keyboardType="decimalPad"/>
                            </textField>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="rb">
                                <constraints>
                                    <constraint firstAttribute="width" constant="44" id="rbw"/>
                                    <constraint firstAttribute="height" constant="44" id="rbh"/>
                                </constraints>
                            </button>
                        </subviews>
                        <constraints>
                            <constraint firstItem="nf" firstAttribute="leading" secondItem="card" secondAttribute="leading" constant="16" id="c1"/>
                            <constraint firstItem="nf" firstAttribute="top" secondItem="card" secondAttribute="top" constant="8" id="c2"/>
                            <constraint firstItem="card" firstAttribute="bottom" secondItem="nf" secondAttribute="bottom" constant="8" id="c3"/>
                            <constraint firstItem="mf" firstAttribute="leading" secondItem="nf" secondAttribute="trailing" constant="8" id="c4"/>
                            <constraint firstItem="mf" firstAttribute="centerY" secondItem="card" secondAttribute="centerY" id="c5"/>
                            <constraint firstItem="rb" firstAttribute="leading" secondItem="mf" secondAttribute="trailing" constant="8" id="c6"/>
                            <constraint firstItem="rb" firstAttribute="centerY" secondItem="card" secondAttribute="centerY" id="c7"/>
                            <constraint firstItem="card" firstAttribute="trailing" secondItem="rb" secondAttribute="trailing" constant="8" id="c8"/>
                        </constraints>
                    </view>
                </subviews>
                <constraints>
                    <constraint firstItem="card" firstAttribute="leading" secondItem="con" secondAttribute="leading" constant="8" id="x1"/>
                    <constraint firstItem="con" firstAttribute="trailing" secondItem="card" secondAttribute="trailing" constant="8" id="x2"/>
                    <constraint firstItem="card" firstAttribute="top" secondItem="con" secondAttribute="top" constant="8" id="x3"/>
                    <constraint firstItem="con" firstAttribute="bottom" secondItem="card" secondAttribute="bottom" constant="8" id="x4"/>
                </constraints>
            </tableViewCellContentView>
            <connections>
                <outlet property="cardView" destination="card" id="oc"/>
                <outlet property="nameField" destination="nf" id="on"/>
                <outlet property="massField" destination="mf" id="om"/>
                <outlet property="removeButton" destination="rb" id="or"/>
                <outlet property="massWidth" destination="mfw" id="ow"/>
            </connections>
        </tableViewCell>
    </objects>
</document>
